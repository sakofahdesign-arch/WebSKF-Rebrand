<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="Laravel Public Assets" stopProcessing="true">
                    <match url="^(assets|build|content|file|images|storage|uploads|favicon\.ico|robots\.txt)(.*)$" ignoreCase="true" />
                    <action type="Rewrite" url="public/{R:0}" />
                </rule>
                <rule name="Laravel Front Controller" stopProcessing="true">
                    <match url=".*" ignoreCase="false" />
                    <action type="Rewrite" url="public/index.php" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
